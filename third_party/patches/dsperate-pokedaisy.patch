+// Auxiliary views use the same clipper, polygon setup, texture decoder and
+// software rasteriser as the game. Shift clip X/Y by a camera-sized fraction
+// of W; the game renderer and its polygon/vertex counters remain untouched.
+void Gpu3D::poke_polygon(const Gpu3D& source, const Vertex* const* v, int count, int dx, int dy) {
+  cur_polygon_attr_ = source.cur_polygon_attr_;
+  texparam_ = source.texparam_; texpal_ = source.texpal_;
+  viewport_ = source.viewport_; zero_dot_w_limit_ = source.zero_dot_w_limit_;
+  poly_mode_ = count == 4 ? 1 : 0; last_strip_poly_ = nullptr;
+  reset_vptr();
+  for (int i = 0; i < count; ++i) {
+    temp_vtx_[i] = *v[i];
+    temp_vtx_[i].pos[0] -= static_cast<s32>((static_cast<s64>(v[i]->pos[3]) * 2 * dx) / 256);
+    temp_vtx_[i].pos[1] += static_cast<s32>((static_cast<s64>(v[i]->pos[3]) * 2 * dy) / 192);
+    temp_vtx_[i].oc = outcode(temp_vtx_[i].pos);
+    temp_vtx_[i].clipped = false;
+  }
+  submit_polygon();
+}
+void Gpu3D::poke_swap_list(const Gpu3D& source) {
+  renderer_.sync_all(); flush_attr_ = source.flush_attr_;
+  finalise_list();
+  { std::lock_guard<std::mutex> lk(bank_mu_);
+    render_bank_ = raster_bank_ = pending_bank_ = bank_; bank_ = next_write_bank(); }
+  num_vertices_ = num_polygons_ = num_opaque_ = 0; last_strip_poly_ = nullptr;
+}
+void Gpu3D::poke_render(const Gpu3D& source) {
+  renderer_.sync_all(); rstate_ = source.rstate_; render_identical_ = false;
+  renderer_.render(*this); renderer_.sync_all();
+}
