@@ -1060,6 +1096,19 @@ void Gpu3D::box_test(const u32* params) {
     for (int i = 0; i < 4; ++i) face[i] = cube[f[i]];
     if (clip_polygon<false>(face, 4, 0, cur_polygon_attr_ & (1 << 12)) > 0) { box_result_ = 1u << 1; return; }
   }
+  // Retry the box against the requested wider frustum, as PokéDaisy does
+  // on melonDS. This makes the game submit geometry needed in the margins.
+  if (poke_submit && (poke_width > 256 || poke_height > 192)) {
+    for (const auto& f : faces) {
+      Vertex face[10];
+      for (int i = 0; i < 4; ++i) {
+        face[i] = cube[f[i]];
+        face[i].pos[0] = static_cast<s32>(static_cast<s64>(face[i].pos[0]) * 256 / poke_width);
+        face[i].pos[1] = static_cast<s32>(static_cast<s64>(face[i].pos[1]) * 192 / poke_height);
+      }
+      if (clip_polygon<false>(face, 4, 0, cur_polygon_attr_ & (1 << 12)) > 0) { box_result_ = 1u << 1; return; }
+    }
+  }
 }
 
